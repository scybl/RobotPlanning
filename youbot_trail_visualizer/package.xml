<?xml version="1.0"?>
<package format="3">
  <name>youbot_trail_visualizer</name>
  <version>0.0.0</version>
  <description>Marker visualisation utilities for YouBot trajectory playback on ROS 2 Foxy.</description>

  <maintainer email="maintainers@example.com">Robotics Portfolio Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>gazebo_msgs</depend>

  <exec_depend>youbot_motion_planning</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
