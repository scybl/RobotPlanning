<?xml version="1.0"?>
<package format="3">
  <name>iiwa_dynamics</name>
  <version>0.0.0</version>
  <description>IIWA14 dynamics model and KDL validation utilities for ROS 2 Foxy.</description>

  <maintainer email="maintainers@example.com">Robotics Portfolio Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-pykdl</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
